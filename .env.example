# Gmail API Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Gmail API OAuth 2.0 Credentials
# =============================================================================
# Download from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Desktop application)

GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:8080

# =============================================================================
# Token Storage (SECURITY: Store outside Obsidian vault)
# =============================================================================
# Absolute or relative paths to store credentials and token files
# These files contain sensitive authentication data

GMAIL_CREDENTIALS_PATH=./credentials/gmail/credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail/token.json

# =============================================================================
# Gmail API Scopes
# =============================================================================
# Full access: https://www.googleapis.com/auth/gmail.modify
# Send: https://www.googleapis.com/auth/gmail.send
# Read-only: https://www.googleapis.com/auth/gmail.readonly

GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.send

# =============================================================================
# Watcher Configuration
# =============================================================================
# How often to check Gmail for new emails (in seconds)

GMAIL_POLL_INTERVAL=120

# Retry settings for API failures
GMAIL_MAX_RETRIES=5
GMAIL_INITIAL_BACKOFF=1
GMAIL_MAX_BACKOFF=300

# =============================================================================
# Security Settings
# =============================================================================
# DEV_MODE: Enable development logging and verbose output
# DRY_RUN: Don't actually send emails (safe for testing)
# RATE_LIMIT_HOURLY: Maximum emails to process per hour

DEV_MODE=true
DRY_RUN=true
RATE_LIMIT_HOURLY=5

# Force approval for specific conditions
FORCE_APPROVAL_NEW_SENDER=true
FORCE_APPROVAL_LEGAL_KEYWORDS=true

# =============================================================================
# Logging Configuration
# =============================================================================
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
# LOG_DIR: Directory to store structured JSON logs

LOG_LEVEL=INFO
LOG_DIR=./Logs

# =============================================================================
# MCP Server Configuration
# =============================================================================
# Port for Email MCP Server

MCP_EMAIL_PORT=8809

# =============================================================================
# Obsidian Vault Configuration
# =============================================================================
# Path to your Obsidian vault (if different from default)

VAULT_PATH=./Vault

# =============================================================================
# Internal Domains (Optional)
# =============================================================================
# Comma-separated list of internal email domains
# Emails from these domains are classified as "internal"

# INTERNAL_DOMAINS=yourcompany.com,subsidiary.com

# =============================================================================
# WhatsApp Web Configuration (Playwright)
# =============================================================================
# WhatsApp Web automation using Playwright MCP Server

# How often to check WhatsApp for new messages (in seconds)
WHATSAPP_POLL_INTERVAL=30

# Browser settings
# HEADLESS: Run browser in background (false = visible browser)
WHATSAPP_BROWSER_HEADLESS=false

# Browser timeout in seconds
WHATSAPP_BROWSER_TIMEOUT=60

# Session timeout in seconds (default: 1 hour)
WHATSAPP_SESSION_TIMEOUT=3600

# Rate limiting: Maximum messages to process per hour
WHATSAPP_RATE_LIMIT_HOURLY=10

# Maximum messages to retrieve per poll
WHATSAPP_MAX_MESSAGES_PER_POLL=20

# MCP Server port for WhatsApp
WHATSAPP_MCP_PORT=8810

# Session storage path (for browser session persistence)
WHATSAPP_SESSION_PATH=./sessions/whatsapp

# Vault path for WhatsApp action files
WHATSAPP_VAULT_PATH=./Vault

# =============================================================================
# AI Draft Reply Generator
# =============================================================================
# Choose provider: 'gemini' (recommended), 'openai', or 'auto' (auto-detect)
AI_DRAFT_PROVIDER=auto

# Google Gemini API (Recommended - Free tier available)
# Get API key: https://makersuite.google.com/app/apikey
# Available models: gemini-2.5-flash, gemini-2.0-flash, gemini-flash-latest
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Alternative)
# Get API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: Custom base URL (for compatible APIs)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Leave both empty to use template fallback (no API key needed)

# =============================================================================
# UltraMsg WhatsApp API (For sending messages)
# =============================================================================
# Get Instance ID and Token from: https://ultramsg.com/
# Required for automatic WhatsApp message sending

ULTRAMSG_INSTANCE_ID=your-instance-id
ULTRAMSG_TOKEN=your-token

# Leave empty to use manual sending (copy/paste to WhatsApp Web)
